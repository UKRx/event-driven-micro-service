{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://shoplite.com/events/StockRejected.v1.schema.json",
  "title": "StockRejected",
  "description": "Event published when inventory cannot reserve stock (insufficient stock)",
  "type": "object",
  "required": ["type", "version", "orderId", "reason", "details", "traceId", "correlationId", "ts"],
  "properties": {
    "type": {
      "type": "string",
      "const": "StockRejected",
      "description": "Event type identifier"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Event schema version"
    },
    "orderId": {
      "type": "string",
      "format": "uuid",
      "description": "Order identifier"
    },
    "reason": {
      "type": "string",
      "enum": ["INSUFFICIENT_STOCK", "PRODUCT_NOT_FOUND"],
      "description": "Reason for stock reservation failure"
    },
    "details": {
      "type": "array",
      "minItems": 1,
      "description": "Details about why stock reservation failed",
      "items": {
        "type": "object",
        "required": ["sku", "requested", "available"],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "description": "Product SKU"
          },
          "requested": {
            "type": "integer",
            "minimum": 1,
            "description": "Quantity requested"
          },
          "available": {
            "type": "integer",
            "minimum": 0,
            "description": "Quantity actually available"
          }
        }
      }
    },
    "traceId": {
      "type": "string",
      "format": "uuid",
      "description": "Distributed tracing identifier"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "Business correlation identifier"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "Event timestamp (ISO-8601)"
    }
  },
  "additionalProperties": false
}
