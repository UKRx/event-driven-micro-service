{
  "realm": "shoplite",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,

  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 1800,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespan": 5184000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,

  "clients": [
    {
      "clientId": "shoplite-api",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "shoplite-secret",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "orders-scope",
        "inventory-scope"
      ]
    },
    {
      "clientId": "shoplite-web",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "orders-scope"
      ]
    }
  ],

  "clientScopes": [
    {
      "name": "orders-scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "orders.read",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "shoplite-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "orders.write",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "shoplite-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "inventory-scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "inventory.read",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "shoplite-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "inventory.write",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "shoplite-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],

  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Customer role - can create and view own orders"
      },
      {
        "name": "admin",
        "description": "Admin role - full access to orders and inventory"
      }
    ]
  },

  "users": [
    {
      "username": "customer",
      "enabled": true,
      "email": "customer@shoplite.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "customer",
          "temporary": false
        }
      ],
      "realmRoles": ["customer"],
      "clientRoles": {
        "shoplite-api": ["customer"]
      }
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@shoplite.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"],
      "clientRoles": {
        "shoplite-api": ["admin"]
      }
    }
  ]
}
