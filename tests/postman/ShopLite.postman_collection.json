{
  "info": {
    "name": "ShopLite - Event-Driven Microservices",
    "description": "API collection for ShopLite order and inventory system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('admin_token', response.access_token);",
                  "pm.test('Token obtained', () => {",
                  "    pm.expect(response.access_token).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "admin",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "shoplite-api",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "shoplite-secret",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/shoplite/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "shoplite", "protocol", "openid-connect", "token"]
            }
          }
        },
        {
          "name": "Get Customer Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('customer_token', response.access_token);",
                  "pm.test('Token obtained', () => {",
                  "    pm.expect(response.access_token).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "customer",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "customer",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "shoplite-api",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "shoplite-secret",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/shoplite/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "shoplite", "protocol", "openid-connect", "token"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('order_id', response.orderId);",
                  "pm.test('Order created', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(response.orderId).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"ABC\",\n      \"qty\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/orders",
              "host": ["{{gateway_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get Order by ID (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Order retrieved', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.id).to.exist;",
                  "    pm.expect(response.status).to.be.oneOf(['PENDING', 'CONFIRMED', 'CANCELLED']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/orders/{{order_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["orders", "{{order_id}}"]
            }
          }
        },
        {
          "name": "Create Order - Insufficient Stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Order created but will be cancelled', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.collectionVariables.set('cancelled_order_id', pm.response.json().orderId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"ABC\",\n      \"qty\": 1000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/orders",
              "host": ["{{gateway_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Unauthorized - No Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 Unauthorized', () => {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"ABC\",\n      \"qty\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/orders",
              "host": ["{{gateway_url}}"],
              "path": ["orders"]
            }
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Adjust Stock (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Stock adjusted', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.sku).to.equal('ABC');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"ABC\",\n  \"delta\": 100\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/inventory/adjust",
              "host": ["{{gateway_url}}"],
              "path": ["inventory", "adjust"]
            }
          }
        },
        {
          "name": "Get Product (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Product retrieved', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response._id).to.equal('ABC');",
                  "    pm.expect(response.available).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/inventory/products/ABC",
              "host": ["{{gateway_url}}"],
              "path": ["inventory", "products", "ABC"]
            }
          }
        },
        {
          "name": "Forbidden - Customer Adjusting Stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 403 Forbidden', () => {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"ABC\",\n  \"delta\": 10\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/inventory/adjust",
              "host": ["{{gateway_url}}"],
              "path": ["inventory", "adjust"]
            }
          }
        }
      ]
    },
    {
      "name": "Health Checks",
      "item": [
        {
          "name": "Gateway Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gateway is healthy', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.equal('ok');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/_health",
              "host": ["{{gateway_url}}"],
              "path": ["_health"]
            }
          }
        },
        {
          "name": "Orders Service Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Orders Service is healthy', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.equal('ok');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orders_url}}/_health",
              "host": ["{{orders_url}}"],
              "path": ["_health"]
            }
          }
        },
        {
          "name": "Inventory Service Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Inventory Service is healthy', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.equal('ok');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventory_url}}/_health",
              "host": ["{{inventory_url}}"],
              "path": ["_health"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "orders_url",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "inventory_url",
      "value": "http://localhost:5002",
      "type": "string"
    },
    {
      "key": "keycloak_url",
      "value": "http://localhost:8180",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "cancelled_order_id",
      "value": "",
      "type": "string"
    }
  ]
}
